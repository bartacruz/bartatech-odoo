<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <record model="ir.ui.view" id="pm_property_type_list">
        <field name="name">pm.property.type.list</field>
        <field name="model">pm.property.type</field>
        <field name="arch" type="xml">
            <list>
            <field name="name" />
            <field name="description" />
            </list>
        </field>
        </record>
    
        <record model="ir.ui.view" id="pm_property_type_form">
        <field name="name">pm.property.type.form</field>
        <field name="model">pm.property.type</field>
        <field name="arch" type="xml">
            <form>
            <sheet>
                <group>
                <field name="name" />
                <field name="description" />
                </group>
            </sheet>
            </form>
        </field>
        </record>
    
        <record model="ir.actions.act_window" id="action_pm_property_type">
        <field name="name">Property Types</field>
        <field name="res_model">pm.property.type</field>
        <field name="view_mode">list,form</field>
        <field name="help">Manage your property types here.</field>
        </record>
    </data>
</odoo>