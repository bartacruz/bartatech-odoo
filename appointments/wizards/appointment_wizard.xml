<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="appointment_wizard_form" model="ir.ui.view">
    <field name="name">appointment.wizard.form</field>
    <field name="model">appointment.wizard</field>
    <field name="arch" type="xml">
        <form string="Calendario de Turnos">
            <group>
                <field name="provider_id" />
                <field name="time_shift_ids" widget="many2many_tags" />
            </group>
            <notebook>
                <page string="Calendario">
                    <field name="slot_ids" widget="m2m_calendar"/>
                </page>
            </notebook>
            <footer>
                <button string="Cerrar" class="btn-secondary" special="cancel"/>
            </footer>
        </form>
    </field>
</record>
<record id="appointment_wizard_action" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">appointment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
