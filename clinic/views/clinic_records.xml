<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record model="ir.ui.view" id="clinic_record_list">
        <field name="name">clinic.record.list</field>
        <field name="model">clinic.record</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="create_date" />
                <field name="record_type" />
                <field name="patient_id" />
                <field name="partner_id" />
                <field name="summary" optional="show" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="clinic_record_form">
        <field name="name">Clinic Record Form</field>
        <field name="model">clinic.record</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="record_type" />
                            <field name="partner_id" />
                            <field name="patient_id" />
                        </group>
                        <group>
                            <field name="name" />
                            <field name="create_date" />
                        </group>
                        <field name="summary" />
                        <field name="notes" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_clinic_record">
        <field name="name">Clinic Records</field>
        <field name="res_model">clinic.record</field>
        <field name="view_mode">list,form</field>
        <field name="help">Manage your clinic records.</field>
    </record>
</odoo>
